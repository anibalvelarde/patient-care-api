{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server={{HOST}};Port={{DB_PORT}};Database={{DB_NAME}};Uid={{DB_USER}};Pwd={{MYSQL_PASSWORD}};"
  },
  "Jwt": {
    "Issuer": "neurocorp-api",
    "Audience": "neurocorp-clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "SigningKey": ""
  },
  "AllowedHosts": "*"
}
