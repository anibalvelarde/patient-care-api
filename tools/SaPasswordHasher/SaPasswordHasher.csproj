<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone helper to generate a PBKDF2 password hash for the SystemAdmin bootstrap
    (see patient-care-db/scripts/bootstrap-sa.sql). It reuses the production hasher
    (Neurocorp.Api.Core.Services.Pbkdf2PasswordHasher) so the generated hash is guaranteed
    compatible with the running API.

    This project is intentionally NOT part of patient-care-api.sln, so it does not affect
    the main build or test run. Invoke it directly:

        dotnet run - -project tools/SaPasswordHasher - - "YourStrongTempPassword"
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Neurocorp.Api.Tools.SaPasswordHasher</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\Core.csproj" />
  </ItemGroup>

</Project>
